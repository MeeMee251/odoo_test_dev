<odoo>
    <data noupdate="1">

        <record id="test_patient_cron" model="ir.cron">
            <field name="name">Check Patient Status</field>
            <field name="model_id" ref="model_hospital_patient"/>
            <field name="state">code</field>
            <field name="code">model.test_cron_job()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

        <record id="test_auto_complete_appointments" model="ir.cron">
            <field name="name">Auto Complete Appointments</field>
            <field name="model_id" ref="model_hospital_appointment"/>
            <field name="state">code</field>
            <field name="code">model.auto_complete_appointments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

    </data>
</odoo>