<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="doctor_tree" model="ir.ui.view">
        <field name="name">hospital.doctor.tree</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="doctor_name"/>
                <field name="gender"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <group>
                        <field name="doctor_name"/>
                        <field name="gender"/>
                        <field name="user_id"/>
                        <field name="appointment_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create First Appointment!
            </p>
        </field>
    </record>

    <menuitem id = "hospital_doctor" name="Doctor" parent="hospital_root" action="action_doctor" sequence="4"/>
</odoo>